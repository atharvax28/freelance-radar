# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GROQ_API_KEY: Optional API key for Groq Cloud LLM provider (Llama 3.3 / Llama 3.1).
GROQ_API_KEY="MY_GROQ_API_KEY"

# Telegram live gig feed (optional). Create a bot via @BotFather for the token,
# and get your chat id from @userinfobot. In CI, set these as GitHub Action secrets.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Google Programmable Search Engine (optional, free 100 queries/day). When both
# are set, the pipeline runs a real web-search source for LinkedIn/GitHub gigs.
# Key: https://developers.google.com/custom-search/v1/introduction
# CX (engine id): https://programmablesearchengine.google.com/
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""

# Pipeline tuning (optional). RECENCY_DAYS: drop postings older than N days.
# MAX_RESULTS: cap total jobs kept. TELEGRAM_MAX_SEND: cap gigs pushed per run.
RECENCY_DAYS="60"
MAX_RESULTS="80"
TELEGRAM_MAX_SEND=""
